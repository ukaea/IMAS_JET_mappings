{
    "ids_properties/homogeneous_time": 0,
    "ids_properties/comment": "JET data mapped using UDA and JSON Mapping Plugin",
    "ids_properties/provider": "Gabor Szepesi",
    "ids_properties/creation_date": "TO BE ADDED",
    "ip": 1,
    "ip[#]/data": {
        "map_type": "DATA_SOURCE",
        "data_source": "MDSPLUS",
        "args": {
            "signal": "PPF/MAGC/IPLA",
            "suffix": "value_of(_aux)"
        }
    },
    "ip[#]/time": {
        "map_type": "DATA_SOURCE",
        "data_source": "MDSPLUS",
        "args": {
            "signal": "PPF/MAGC/IPLA",
            "suffix": "dim_of(_aux, 0)"
        }
    },
    "ip[#]/method_name": "Line integral of IDCs",
    "b_field_pol_probe": "{{ length(BPOL_PROBES) }}",
    "b_field_pol_probe[#]/name": "{{ at(BPOL_PROBES, #0) }}",
    "b_field_pol_probe[#]/identifier": "BPOL_PROBE_{{ #0 + 1 }}",
    "b_field_pol_probe[#]/type/name": "mirnov",
    "b_field_pol_probe[#]/type/index": 2,
    "b_field_pol_probe[#]/type/description": "Mirnov probe",
    "b_field_pol_probe[#]/position/r": "{{ at(BPOL_R, #0) }}",
    "b_field_pol_probe[#]/position/z": "{{ at(BPOL_Z, #0) }}",
    "b_field_pol_probe[#]/position/phi": "{{ at(BPOL_PHI, #0) }}",
    "_b_field_pol_probe[#]/position/area": "<not mapped>",
    "_b_field_pol_probe[#]/position/length": "<not mapped>",
    "_b_field_pol_probe[#]/turns": "<not mapped>",
    "b_field_pol_probe[#]/field/data": {
        "map_type": "DATA_SOURCE",
        "data_source": "MDSPLUS",
        "args": {
            "signal": "PPF/MAGC/BPME"
        },
		"slice": "[:][{{ #0 }}]"
    },
    "b_field_pol_probe[#]/field/time": {
       "map_type": "DATA_SOURCE",
        "data_source": "MDSPLUS",
        "args": {
            "signal": "PPF/MAGC/BPME",
            "suffix": "dim_of(_aux, 1)"
        }
    },
    "b_field_pol_probe[#]/poloidal_angle": "{{ at(BPOL_POL, #0) }}",
    "b_field_pol_probe[#]/toroidal_angle": 0,
    "flux_loop": "{{ length(FLUX_LOOPS) }}",
    "flux_loop[#]/name": "{{ at(FLUX_LOOPS, #0) }}",
    "flux_loop[#]/identifier": "FLUX_LOOP_{{ #0 + 1 }}",
    "flux_loop[#]/type/name": "<INSERT>",
    "flux_loop[#]/type/index": "<INSERT>",
    "flux_loop[#]/position": "{{ length(at(FL_POSITION_R, #0)) }}",
    "flux_loop[#]/position[#]/r": "{{ at(at(FL_POSITION_R, #0), #1) }}",
    "flux_loop[#]/position[#]/z": "{{ at(at(FL_POSITION_Z, #0), #1) }}",
    "flux_loop[#]/position[#]/phi": "{{ at(FL_POSITION_PHI, #0) }}",
    "flux_loop[#]/flux/data": {
        "map_type": "DATA_SOURCE",
        "data_source": "MDSPLUS",
        "args": {
            "signal": "PPF/MAGC/FLME"
        },
		"slice": "[:][{{ #0 }}]"
    },
    "flux_loop[#]/flux/time": {
        "map_type": "DATA_SOURCE",
        "data_source": "MDSPLUS",
        "args": {
            "signal": "PPF/MAGC/FLME",
			"suffix": "dim_of(_aux, 1)"
        }
    },
    "_flux_loop[#]/voltage": {
       "map_type": "DATA_SOURCE",
        "data_source": "MDSPLUS",
        "args": {
            "signal": "<INSERT SIGNAL STRING"
        },
        "comment": "The final syntax of this string may change"
    }
}
