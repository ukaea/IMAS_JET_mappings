{
    "ids_properties/homogeneous_time": 1,
    "ids_properties/comment": "JET data mapped using UDA and JSON Mapping Plugin",
    "ids_properties/provider": "Rui Coelho",
    "ids_properties/creation_date": "TO BE ADDED",
    "_r": {
        "map_type": "DATA_SOURCE",
        "data_source": "MDSPLUS",
        "args": {
            "signal": "PPF/HRTS/NE",
            "suffix": "dim_of(_aux, 0)"
        }
    },
    "time": {
        "map_type": "DATA_SOURCE",
        "data_source": "MDSPLUS",
        "args": {
            "signal": "PPF/HRTS/NE",
            "suffix": "dim_of(_aux, 1)"
        }
    },
    "channel": {
        "map_type": "DIMENSION",
        "dim_probe": "_r"
    },
    "channel[#]/name": "CH{{ indices.0 +1 }}",
    "channel[#]/position/r": {
        "map_type": "DATA_SOURCE",
        "data_source": "MDSPLUS",
        "args": {
            "signal": "PPF/HRTS/NE",
            "suffix": "dim_of(_aux, 0)"
        },
        "slice": "[{{ #0 }}]"
    },
    "channel[#]/position/z": {
       "map_type": "DATA_SOURCE",
        "data_source": "MDSPLUS",
        "args": {
            "signal": "PPF/HRTS/Z",
            "suffix": "value_of(_aux)"
        },
        "slice": "[{{ indices.0 }}][:]"
    },
    "channel[#]/position/phi": {
        "map_type": "VALUE",
        "VALUE": 0
    },
     "channel[#]/t_e/data": {
       "map_type": "DATA_SOURCE",
        "data_source": "MDSPLUS",
        "args": {
            "signal": "PPF/HRTS/TE",
            "suffix": "value_of(_aux)"
        },
        "slice": "[{{ indices.0 }}][:]"
    },
     "channel[#]/t_e/data_error_upper": {
       "map_type": "DATA_SOURCE",
        "data_source": "MDSPLUS",
        "args": {
            "signal": "PPF/HRTS/DTE",
            "suffix": "value_of(_aux)"
        },
        "slice": "[{{ indices.0 }}][:]"
    },
    "channel[#]/t_e/time": {
        "map_type": "DATA_SOURCE",
        "data_source": "MDSPLUS",
        "args": {
            "signal": "PPF/HRTS/NE",
            "suffix": "dim_of(_aux, 1)"
        }
    },
     "channel[#]/n_e/data": {
       "map_type": "DATA_SOURCE",
        "data_source": "MDSPLUS",
        "args": {
            "signal": "PPF/HRTS/NE",
            "suffix": "value_of(_aux)"
        },
        "slice": "[{{ indices.0 }}][:]"
    },
     "channel[#]/n_e/data_error_upper": {
       "map_type": "DATA_SOURCE",
        "data_source": "MDSPLUS",
        "args": {
            "signal": "PPF/HRTS/DNE",
            "suffix": "value_of(_aux)"
        },
        "slice": "[{{ indices.0 }}][:]"
    },
    "channel[#]/n_e/time": {
        "map_type": "DATA_SOURCE",
        "data_source": "MDSPLUS",
        "args": {
            "signal": "PPF/HRTS/NE",
            "suffix": "dim_of(_aux, 1)"
        }
    }
}
