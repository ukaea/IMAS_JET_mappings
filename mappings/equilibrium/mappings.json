    "time_slice[#]/profiles_2d": 1,
    "time_slice[#]/profiles_2d[0]/psi": {
        "map_type": "DATA_SOURCE",
        "data_source": "MDSPLUS",
        "args": {
            "signal": ";",
            "suffix": "public _psiz=jet(\"PPF/EFTP/PSIZ\", {{ shot }}); _nz=size(data(_psiz)); public _psir=jet(\"PPF/EFTP/PSIR\", {{ shot }}); _nr=size(data(_psir)); _a=jet(\"PPF/EFTP/PSI\", {{ shot }}); public _nt=size(dim_of(_a,1)); _bubu=build_signal(jreshape(data(_a),[_nr,_nz,size(data(_a))/_nr/_nz]),*,data(_psir),data(_psiz),dim_of(_a,1)); _sig=_bubu"
        },
        "scale": -6.2831853072,
		"slice": "[{{ #0 }}][:][:]"
    },
    "time_slice[#]/profiles_2d[0]/grid_type/index": 1,
    "time_slice[#]/profiles_2d[0]/grid_type/name": "rectangular",
