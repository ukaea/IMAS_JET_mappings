    "time_slice[#]/profiles_1d/psi": {
        "map_type": "DATA_SOURCE",
        "data_source": "MDSPLUS",
        "args": {
            "signal": "PPF/EFTP/F",
            "suffix": "_nrad=size(_aux,0); _nt=size(_aux,1); _psiaxaux=jet(\"PPF/EFTP/FAXS\", {{ shot }}); _psibndaux=jet(\"PPF/EFTP/FBND\", {{ shot }}); _psiax=SPREAD(_psiaxaux,0,_nrad); _psibnd=SPREAD(_psibndaux,0,_nrad); _sig = BUILD_SIGNAL(_psiax + (_psibnd - _psiax)*SPREAD(dim_of(_aux,0),1,_nt),*,dim_of(_aux,0),dim_of(_aux,1))"
        },
        "scale": -6.2831853072,
		"slice": "[{{ #0 }}][:]"
    },
    "time_slice[#]/profiles_1d/psi_norm": {
        "map_type": "DATA_SOURCE",
        "data_source": "MDSPLUS",
        "args": {
            "signal": "PPF/EFTP/F",
            "suffix": "_nt=size(_aux,1); _sig = BUILD_SIGNAL(SPREAD(dim_of(_aux,0),1,_nt),*,dim_of(_aux,0),dim_of(_aux,1))"
