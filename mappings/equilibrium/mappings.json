        "map_type": "DATA_SOURCE",
        "data_source": "MDSPLUS",
        "args": {
            "signal": "PPF/EFTP/BVAC"
        }
    },
    "time_slice": {
        "map_type": "DIMENSION",
        "dim_probe": "time"
    },
