{
    "ids_properties/homogeneous_time": {
        "MAP_TYPE": "VALUE",
        "VALUE": 0
    },
    "coil": {
        "MAP_TYPE": "VALUE",
        "VALUE": "{{ length(PF_COILS) }}"
    },
    "coil[#]/name": {
        "MAP_TYPE": "VALUE",
        "VALUE": "{{ PF_COIL_NAME }}"
    },
    "coil[#]/identifier" : {
        "MAP_TYPE": "VALUE",
        "VALUE": "PF_COIL_{{ indices.0 + 1 }}"
    },
    "_coil[#]/current" : {
        "COMMENT": "<TODO>"
    },
    "_coil[#]/current/time": {
        "COMMENT": "<TODO>"
    },
    "coil[#]/function": {
        "MAP_TYPE": "VALUE",
        "VALUE": 1
    },
    "_coil[#]/function[#]/index": {
        "COMMENT": "<TODO>"
    },
    "coil[#]/element" : {
        "MAP_TYPE": "DIMENSION",
        "VALUE": "{{ length(PF_COIL_ELEMENTS) }}"
    },
    "coil[#]/element[#]/identifier" : {
        "MAP_TYPE": "VALUE",
        "VALUE": "PF_COIL_{{ indices.0 + 1 }}_E{{ indices.1 + 1 }}"
    },
    "coil[#]/element[#]/turns_with_sign" : {
        "MAP_TYPE": "VALUE",
        "VALUE": "{{ at(PF_COILS_ELEMENTS, indices.1).turns }}"
    },
    "coil[#]/element[#]/geometry/geometry_type": {
        "MAP_TYPE": "VALUE",
        "VALUE": 2,
        "COMMENT": "2 for rectangle"
    },
    "_coil[#]/element[#]/geometry/rectangle/size": {
        "COMMENT": "<TODO>"
    },
    "coil[#]/element[#]/geometry/rectangle/r": {
        "MAP_TYPE": "VALUE",
        "VALUE": "{{ at(PF_COILS_ELEMENTS, indices.1).r }}"
    },
    "coil[#]/element[#]/geometry/rectangle/z": {
        "MAP_TYPE": "VALUE",
        "VALUE": "{{ at(PF_COILS_ELEMENTS, indices.1).z }}"
    },
    "coil[#]/element[#]/geometry/rectangle/width": {
        "MAP_TYPE": "VALUE",
        "VALUE": "{{ at(PF_COILS_ELEMENTS, indices.1).width }}"
    },
    "coil[#]/element[#]/geometry/rectangle/height": {
        "MAP_TYPE": "VALUE",
        "VALUE": "{{ at(PF_COILS_ELEMENTS, indices.1).height }}"
    }
}
