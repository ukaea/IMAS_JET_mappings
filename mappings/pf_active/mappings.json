{
    "ids_properties/homogeneous_time": {
        "MAP_TYPE": "VALUE",
        "VALUE": 1
    },
    "ids_properties/comment": {
        "MAP_TYPE": "VALUE",
        "VALUE": "JET data mapped using UDA and JSON Mapping Plugin"
    },
    "ids_properties/provider": {
        "MAP_TYPE": "VALUE",
        "VALUE": "Rui Coelho, Adam Parker and Gabor Szepesi",
        "COMMENT": "Automatic from PPF data and hardcoded static data stored in globals"
    },
    "ids_properties/creation_date": {
        "MAP_TYPE": "VALUE",
        "VALUE": "03.07.2025",
        "COMMENT": "Ideally from system date..."
    },
    "_data1": {
        "MAP_TYPE": "PLUGIN",
        "PLUGIN": "MDSPLUS",
        "ARGS": {
            "signal": "_aux=jet(\"PPF/MAGN/ECME\"% {{ shot }}); _sig = value_of(_aux)"
        },
        "COMMENT": "This contains the first batch of data for the PF_ACTIVE coils"
    },
    "_data2": {
        "MAP_TYPE": "PLUGIN",
        "PLUGIN": "MDSPLUS",
        "ARGS": {
            "signal": "_aux=jet(\"PPF/MAGN/FCME\"% {{ shot }}); _sig = value_of(_aux)"
        },
        "COMMENT": "This contains the second batch of data for the PF_ACTIVE coils"
    },
    "time": {
        "MAP_TYPE": "PLUGIN",
        "PLUGIN": "MDSPLUS",
        "ARGS": {
            "signal": "_aux=jet(\"PPF/MAGN/IPLA\"% {{ shot }}); _sig = dim_of(_aux% 0)"
        },
        "COMMENT": "Time is supposed to be homogeneous since taken from MAGN/IPLA..."
    },
    "coil": {
        "MAP_TYPE": "VALUE",
        "VALUE": "{{ length(PF_COILS) }}"
    },
    "coil[#]/name": {
        "MAP_TYPE": "VALUE",
        "VALUE": "{{ PF_COIL_NAME }}"
    },
    "coil[#]/identifier" : {
        "MAP_TYPE": "VALUE",
        "VALUE": "PF_COIL_{{ indices.0 + 1 }}"
    },
    "coil[#]/current/data" : {
        "MAP_TYPE": "PLUGIN",
        "PLUGIN": "MDSPLUS",
        "ARGS": {
            "signal": "{{ PF_COIL_CURRENT }}"
        }
    },
    "coil[#]/function": {
        "MAP_TYPE": "VALUE",
        "VALUE": 1
    },
    "_coil[#]/function[#]/index": {
        "MAP_TYPE": "VALUE",
        "VALUE": 1
    },
    "coil[#]/element" : {
        "MAP_TYPE": "VALUE",
        "VALUE": "{{ length(at(PF_COILS, indices.0).elements) }}"
    },
    "coil[#]/element[#]/identifier" : {
        "MAP_TYPE": "VALUE",
        "VALUE": "PF_COIL_{{ indices.0 + 1 }}_E{{ indices.1 + 1 }}"
    },
    "coil[#]/element[#]/turns_with_sign" : {
        "MAP_TYPE": "VALUE",
        "VALUE": "{{ at( at(PF_COILS, indices.0).elements, indices.1).turns }}"
    },
    "coil[#]/element[#]/geometry/geometry_type": {
        "MAP_TYPE": "VALUE",
        "VALUE": 2,
        "COMMENT": "2 for rectangle"
    },
    "coil[#]/element[#]/geometry/rectangle/r": {
        "MAP_TYPE": "VALUE",
        "VALUE": "{{ at( at(PF_COILS, indices.0).elements, indices.1).r }}"
    },
    "coil[#]/element[#]/geometry/rectangle/z": {
        "MAP_TYPE": "VALUE",
        "VALUE": "{{ at( at(PF_COILS, indices.0).elements, indices.1).z }}"
    },
    "coil[#]/element[#]/geometry/rectangle/width": {
        "MAP_TYPE": "VALUE",
        "VALUE": "{{ at( at(PF_COILS, indices.0).elements, indices.1).width }}"
    },
    "coil[#]/element[#]/geometry/rectangle/height": {
        "MAP_TYPE": "VALUE",
        "VALUE": "{{ at( at(PF_COILS, indices.0).elements, indices.1).height }}"
    }
}

COMMENTS:
PPF DDA: MAGC/PFS -> 2D array [time,nPF_circuits]. There are just 10 circuit currents but nPF_circuits = 12 to
         /PFSY -> string with the actual method (sc or lkat) but it's a comment so not easy to fetch via MDSplus
		 The 11th column is P4U and 12th column is P4L. Columns 5 and 6 should be ignored (avg and imbalance of P4 pair)

'P1Eu_P1El_P3M':PFS[:,0]

'P1C  ':PFS[:,0]+PFS[:,1]

'P4U      ':PFS[:,10]

'P3SU      ':PFS[:,2]

'P3RU     ':PFS[:,3]

'P2RU     ':PFS[:,3]

'P2SU     ':PFS[:,2]

'P4L      ':PFS[:,11]

'P3SL     ':PFS[:,2]

'P3RL     ':PFS[:,3]

'P2RL     ':PFS[:,3]

'P2SL     ':PFS[:,2]

'D1       ':PFS[:,6]

'D2       ':PFS[:,7]

'D3       ':PFS[:,8]

'D4       ':PFS[:,9]



