{
    "ids_properties/homogeneous_time": 1,
    "ids_properties/comment": "JET data mapped using UDA and JSON Mapping Plugin",
    "ids_properties/provider": "Rui Coelho, Adam Parker and Gabor Szepesi",
    "ids_properties/creation_date": "03.07.2025",
    "time": {
        "MAP_TYPE": "DATA_SOURCE",
        "DATA_SOURCE": "MDSPLUS",
        "ARGS": {
            "signal": "PPF/MAGC/IPLA",
			"suffix": "dim_of(_aux, 0)"
        }
    },
    "coil": "{{ length(PF_COILS) }}",
    "coil[#]/name": "{{ PF_COIL_NAME }}",
    "coil[#]/identifier" : "PF_COIL_{{ #0 + 1 }}",
    "coil[#]/current/data" : {
        "MAP_TYPE": "DATA_SOURCE",
        "DATA_SOURCE": "CUSTOM_JET",
        "ARGS": {
            "coil_name": "{{ PF_COIL_NAME }}"
        },
		"FUNCTION": "pf_coil_current"
    },
    "coil[#]/function": 1,
    "coil[#]/function[#]/index": 1,
    "coil[#]/element" : "{{ length(at(PF_COILS, indices.0).elements) }}",
    "coil[#]/element[#]/identifier" : "PF_COIL_{{ #0 + 1 }}_E{{ #1 + 1 }}",
    "coil[#]/element[#]/turns_with_sign" : "{{ PF_COIL_ELEMENT_TURNS }}",
    "coil[#]/element[#]/geometry/geometry_type": 2,
    "coil[#]/element[#]/geometry/rectangle/r": "{{ PF_COIL_ELEMENT_R }}",
    "coil[#]/element[#]/geometry/rectangle/z": "{{ PF_COIL_ELEMENT_Z }}",
    "coil[#]/element[#]/geometry/rectangle/width": "{{ PF_COIL_ELEMENT_WIDTH }}",
    "coil[#]/element[#]/geometry/rectangle/height": "{{ PF_COIL_ELEMENT_HEIGHT }}"
}
